        "commitCdPresetName(3)"
      ],
      "expect": {
        "cdPresets[3]": {
          "sec": 300,
          "name": "휴식"
        },
        "cdNamingIdx": -1
      },
      "v": 1
    },
    {
      "id": "beh-5",
      "assert": "4칸 꽉 찬 상태에서 저장 = 덮어쓸 칸 선택(pick) 모드 + 힌트 전환",
      "expect": {
        "cdPickMode": true,
        "cd-hint.textContent": "덮어쓸 칸을 클릭 (Esc 취소)"
      },
      "v": 1
    },
    {
      "id": "beh-6",
      "assert": "pick 모드에서 칸 클릭 = 덮어쓰기 후 이름 입력 모드(기존 동작 유지 — 이름 리셋됨)",
      "steps": [
        "writeCdPreset(0)"
      ],
      "expect": {
        "cdPresets[0]": {
          "sec": 540,
          "name": ""
        },
        "cdNamingIdx": 0,
        "cdPickMode": false
      },
      "v": 1
    },
    {
      "id": "beh-7",
      "assert": "Esc로 pick 모드 취소",
      "expect": {
        "cdPickMode": false
      },
      "v": 1
    },
    {
      "id": "beh-8",
      "assert": "카운트다운 실행 중에는 프리셋 섹션과 저장 버튼이 비활성",
      "steps": [
